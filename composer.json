{
    "name": "sportsgearswag/artwork-vectorizer",
    "description": "Converts raster artwork into colour-separated, print-ready SVG: one editable layer per ink, snapped to a PMS palette.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "svg",
        "vectorize",
        "potrace",
        "vtracer",
        "screen-printing",
        "pantone"
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "ext-imagick": "Not used directly; the ImageMagick CLI is required instead"
    },
    "autoload": {
        "psr-4": {
            "Sgs\\Vectorizer\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Sgs\\Vectorizer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
